# Copy to backend/.env and adjust as needed.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: also allow origins matching a regex (e.g. Vercel preview deployments).
# CORS_ORIGIN_REGEX=https://farmshield-[a-z0-9-]+\.vercel\.app

# live   = risk engines run on NASA data where available (flood today); demo data fills the rest.
# sample = the bundled demo scenario only (dramatic and deterministic, good for offline pitches).
DATA_MODE=live

# --- NASA data pipeline ------------------------------------------------------------
# Works without any login: NASA POWER, MODIS (ORNL DAAC), VIIRS baseline, CMR metadata.
# Where downloaded observations are cached.
PIPELINE_DB_PATH=data/farmshield.db
# Refresh NASA data in the background when the API starts (cache-aware).
PIPELINE_AUTO_REFRESH=true
PIPELINE_DAYS=60

# NASA Earthdata token: unlocks mission-native GPM IMERG rainfall and SMAP soil moisture.
# Free: https://urs.earthdata.nasa.gov → Generate Token. Without it, NASA POWER stands in.
EARTHDATA_TOKEN=

# --- AI Farmer Assistant ------------------------------------------------------------
# Anthropic API key: the assistant writes free-form answers with Claude. Without it, a
# built-in bilingual helper answers common questions from the same NASA-based results.
# Get one at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# low keeps chat replies quick; medium/high think longer.
ASSISTANT_EFFORT=low
