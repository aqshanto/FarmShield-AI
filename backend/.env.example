# Copy to backend/.env and adjust as needed.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# sample = bundled demo data, live = real NASA services (Phase 4)
DATA_MODE=sample

# NASA Earthdata token (https://urs.earthdata.nasa.gov) - needed only for live mode
EARTHDATA_TOKEN=

# Claude API key - needed for the AI Farmer Assistant (Prompt 09)
ANTHROPIC_API_KEY=
