{
  "name": "farmshield-ai",
  "version": "0.1.0",
  "private": true,
  "description": "NASA-powered climate intelligence platform for farmers.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/python.mjs -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node scripts/python.mjs -m pytest -q",
    "test:web": "npm --prefix frontend test",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
